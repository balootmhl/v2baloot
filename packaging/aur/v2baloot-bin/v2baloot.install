post_install() {
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  cat <<'MSG'
==> v2baloot installed. Per user, run once:
      systemctl --user enable --now v2baloot
    Optional Omarchy integration (Waybar module, keybindings):
      /usr/share/v2baloot/   (see README, or run ./install.sh --integrate)
MSG
}

post_upgrade() {
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  echo "==> Restart the daemon to use the new version: systemctl --user restart v2baloot"
}
