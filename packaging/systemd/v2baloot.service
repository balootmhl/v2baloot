[Unit]
Description=v2baloot Xray client daemon
Documentation=https://github.com/balootmhl/v2baloot
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/v2baloot daemon
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info

[Install]
WantedBy=graphical-session.target
